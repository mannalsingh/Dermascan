# ── Server & Database (COMPULSORY) ─────────────────────────
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/yourdatabasename
JWT_SECRET=your_very_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PUBLIC_URL=http://localhost:8000
BASE_URL=http://localhost:5000
UPLOAD_DIR=uploads/

# ── Frontend CORS Allowlist (COMPULSORY) ───────────────────
CLIENT_URL=https://dermascan-bay.vercel.app,http://localhost:3000

# ── Google OAuth Verification (COMPULSORY) ─────────────────
GOOGLE_CLIENT_ID=

# ── Brevo Transactional Email API (COMPULSORY for sending OTP to any arbitrary user) ──
# 100% Free: 300 emails/day, no credit card, no domain purchase required.
EMAIL_PROVIDER=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
